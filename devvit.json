{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "menu": {
    "items": [
      {
        "description": "Error 404: Soul Not Found — daily soul sorting game",
        "endpoint": "/internal/menu/post-create",
        "forUserType": "moderator",
        "label": "Create Error 404 post",
        "location": "subreddit"
      }
    ]
  },
  "name": "soul-not-found-404",
  "permissions": {
    "reddit": true,
    "redis": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "inline": true
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "dev": {
    "subreddit": "soul_not_found_40_dev"
  }
}